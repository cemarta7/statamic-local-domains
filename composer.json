{
    "name": "cemarta7/statamic-local-domains",
    "description": "Use multiple local hostnames with a single Statamic site without changing APP_URL.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "statamic/cms": "^5.0 || ^6.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Cemarta7\\StatamicLocalDomains\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cemarta7\\StatamicLocalDomains\\LocalDomainsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
